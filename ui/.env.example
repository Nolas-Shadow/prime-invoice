# Contract deployment address (falls back to local Hardhat default: 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512)
VITE_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Project ID for RainbowKit / WalletConnect
VITE_RAINBOW_PROJECT_ID=0227bb3c3c788df7908b9cbfdec19e07

# EVM chain id(s), comma-separated. Protocol is chain-agnostic; this only configures the wallet.
